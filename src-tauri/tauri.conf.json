{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面图标备份",
  "version": "0.4.1",
  "identifier": "com.liang.desktopiconbackup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌面图标备份",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "TradChinese", "English", "French", "Korean", "Japanese"]
      }
    }
  }
}
